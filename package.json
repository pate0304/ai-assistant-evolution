{
  "name": "ai-assistant-evolution",
  "version": "0.1.0",
  "description": "Open-source framework for evolving AI assistants",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "setup": "node scripts/setup.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "ai",
    "assistant",
    "machine-learning",
    "evolution",
    "self-improvement",
    "rlhf",
    "memory",
    "persona"
  ],
  "author": "AI Evolution Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pate0304/ai-assistant-evolution.git"
  },
  "dependencies": {
    "express": "^4.18.2",
    "redis": "^4.6.5",
    "pg": "^8.10.0",
    "neo4j-driver": "^5.8.0",
    "weaviate-ts-client": "^1.4.0",
    "openai": "^4.28.4",
    "@anthropic-ai/sdk": "^0.17.1",
    "winston": "^3.8.2",
    "joi": "^17.9.1",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "cors": "^2.8.5",
    "helmet": "^6.1.5",
    "rate-limiter-flexible": "^2.4.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.40.0",
    "@types/node": "^18.16.3",
    "webpack": "^5.82.1",
    "webpack-cli": "^5.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}